# OpenAI-compatible endpoint served on the 4090 machine (localhost only).
EXECLOC_BASE_URL=http://localhost:11434/v1
# Model name as the server exposes it.
EXECLOC_MODEL=devstral-small-2
# Any non-empty string; the server ignores it.
EXECLOC_API_KEY=local

# Optional: recorded in results/<run_id>/meta.json.
EXECLOC_MODEL_REVISION=
EXECLOC_SERVING_ENGINE=ollama
EXECLOC_CONTEXT_LENGTH=32768
